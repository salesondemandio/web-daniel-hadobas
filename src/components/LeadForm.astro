---
// Lead capture form — submits to /api/lead → GHL
// Optional props let campaign landing pages override the heading copy and tag
// their leads without changing the homepage (all default to current values).
interface Props {
  eyebrow?: string;
  heading?: string;
  sub?: string;
  reassurance?: string;
  campaignTag?: string;
  variant?: 'default' | 'command';
}

const {
  eyebrow = 'Free Solar Analysis',
  heading = 'See How Much You Can Save',
  sub = 'Takes 60 seconds. No credit check. Daniel calls you within the hour.',
  reassurance = "If solar doesn't save you money, he'll tell you on the call.",
  campaignTag = '',
  variant = 'default',
} = Astro.props;

const isCommand = variant === 'command';

// Card shell: homepage stays slate; command variant gets the dark "command center" skin + green glow.
const cardClass = isCommand
  ? 'bg-[#0C2014]/80 border border-white/10 rounded-2xl p-8 space-y-5'
  : 'bg-slate-800/60 border border-slate-700 rounded-2xl p-8 space-y-5';
const cardStyle = isCommand
  ? 'box-shadow:0 0 0 1px rgba(141,214,106,0.12),0 24px 70px -30px rgba(106,183,69,0.45)'
  : '';

// Inputs/select base: command variant uses near-black fields; both keep green focus ring.
const fieldBg = isCommand ? 'bg-[#07140D] border-white/10' : 'bg-slate-900 border-slate-600';
const inputClass = `w-full ${fieldBg} border text-white placeholder-slate-500 rounded-lg px-4 py-3 text-sm focus:outline-none focus:border-brand-orange focus:ring-1 focus:ring-brand-orange transition`;
const selectClass = `w-full ${fieldBg} border text-slate-300 rounded-lg px-4 py-3 text-sm focus:outline-none focus:border-brand-orange focus:ring-1 focus:ring-brand-orange transition`;

// Heading: command variant uses the display serif; homepage keeps font-bold.
const headingClass = isCommand
  ? 'text-3xl sm:text-4xl font-display text-white mb-3'
  : 'text-3xl sm:text-4xl font-bold text-white mb-3';

// Labels bumped to text-base for readability (both variants).
const labelClass = 'block text-base font-semibold text-slate-300 mb-1.5';
---

<section class="relative py-20 bg-[#050708] overflow-hidden" id="get-quote" style="background-image:radial-gradient(ellipse 70% 80% at 50% 0%, rgba(106,183,69,0.12) 0%, transparent 60%);">
  <div class="relative max-w-2xl mx-auto px-4 sm:px-6">
    <div class="text-center mb-8">
      <p class="text-brand-orange font-semibold text-sm uppercase tracking-widest mb-2">{eyebrow}</p>
      <h2 class={headingClass}>{heading}</h2>
      <p class="text-slate-400 text-base">{sub}</p>
      <p class="text-[#8DD66A] font-semibold text-sm mt-3">{reassurance}</p>
    </div>

    <form id="lead-form" class={cardClass} style={cardStyle}>
      {campaignTag && <input type="hidden" name="campaignTag" value={campaignTag} />}
      {/* Honeypot — hidden from sighted users + assistive tech, but submitted. API drops bots that fill it. */}
      <div style="position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden" aria-hidden="true">
        <label for="lf-website">Website</label>
        <input
          id="lf-website"
          name="website"
          type="text"
          tabindex="-1"
          autocomplete="off"
          aria-hidden="true"
        />
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <div>
          <label for="lf-name" class={labelClass}>Full Name *</label>
          <input
            id="lf-name"
            name="name"
            type="text"
            required
            autocomplete="name"
            placeholder="Jane Smith"
            class={inputClass}
          />
        </div>
        <div>
          <label for="lf-phone" class={labelClass}>Phone *</label>
          <input
            id="lf-phone"
            name="phone"
            type="tel"
            required
            autocomplete="tel"
            inputmode="tel"
            placeholder="(702) 555-0100"
            class={inputClass}
          />
        </div>
      </div>

      <div>
        <label for="lf-email" class={labelClass}>Email</label>
        <input
          id="lf-email"
          name="email"
          type="email"
          autocomplete="email"
          placeholder="you@email.com"
          class={inputClass}
        />
      </div>

      <div>
        <label for="lf-address" class={labelClass}>Home Address</label>
        <input
          id="lf-address"
          name="address"
          type="text"
          autocomplete="street-address"
          placeholder="123 Main St, Las Vegas, NV"
          class={inputClass}
        />
      </div>

      <div>
        <label for="lf-bill" class={labelClass}>Monthly Electric Bill</label>
        <select
          id="lf-bill"
          name="electricBill"
          class={selectClass}
        >
          <option value="">Select your range</option>
          <option value="$100–$150">$100 – $150</option>
          <option value="$150–$200">$150 – $200</option>
          <option value="$200–$300">$200 – $300</option>
          <option value="$300–$400">$300 – $400</option>
          <option value="$400+">$400+</option>
        </select>
      </div>

      <!-- Cloudflare Turnstile bot protection. Sitekey is public; secret is the Pages env TURNSTILE_SECRET.
           The api.js loader is injected lazily (see script below) only when the form nears the viewport —
           deferring its third-party cookies keeps the best-practices score from being dragged down on
           every page load. The div reserves space so the widget doesn't shift layout when it renders. -->
      <div class="cf-turnstile min-h-[65px]" data-sitekey="0x4AAAAAADW-wIU96q9BUuLA" data-theme="dark"></div>

      <div
        id="lead-error"
        role="alert"
        class="hidden bg-red-950/40 border border-red-500/40 text-red-200 rounded-lg px-4 py-3 text-sm"
      ></div>

      <button
        type="submit"
        id="lf-submit"
        class="w-full bg-brand-orange text-white font-bold py-4 rounded-lg text-base cta-glow hover:brightness-110 transition disabled:opacity-60 disabled:cursor-not-allowed"
      >
        Get My Free Solar Savings Analysis
      </button>

      <p class="text-center text-xs text-slate-400">
        No obligation. No hard sell. Daniel calls — not a call center.
      </p>
      <p class="text-center text-xs text-slate-500">
        By submitting, you agree Daniel may call or text you about your free quote. Message and data rates may apply. No spam, ever.
      </p>
    </form>

    <!-- Success state -->
    <div id="lead-success" role="status" aria-live="polite" class="hidden bg-slate-800/60 border border-green-600/40 rounded-2xl p-10 text-center">
      <div class="w-14 h-14 rounded-full bg-green-600/20 flex items-center justify-center mx-auto mb-4">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 6L9 17l-5-5"/>
        </svg>
      </div>
      <h3 id="lead-success-heading" tabindex="-1" class="text-white font-bold text-xl mb-2 focus:outline-none">You're on Daniel's List</h3>
      <p class="text-slate-400 text-sm" id="lead-success-msg">He'll be in touch within the hour to walk you through your savings estimate.</p>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('lead-form') as HTMLFormElement;
  const success = document.getElementById('lead-success') as HTMLDivElement;
  const successMsg = document.getElementById('lead-success-msg') as HTMLParagraphElement;
  const successHeading = document.getElementById('lead-success-heading') as HTMLHeadingElement;
  const submitBtn = document.getElementById('lf-submit') as HTMLButtonElement;
  const errorBox = document.getElementById('lead-error') as HTMLDivElement;

  // Lazy-load Cloudflare Turnstile only when the form approaches the viewport,
  // so its third-party cookies/script don't load (and tank best-practices) on
  // every page view. Falls back to immediate load if IntersectionObserver is missing.
  let turnstileLoaded = false;
  const loadTurnstile = () => {
    if (turnstileLoaded) return;
    turnstileLoaded = true;
    const s = document.createElement('script');
    s.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js';
    s.async = true;
    s.defer = true;
    document.head.appendChild(s);
  };
  if (form) {
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries, obs) => {
        if (entries.some((e) => e.isIntersecting)) { loadTurnstile(); obs.disconnect(); }
      }, { rootMargin: '300px' });
      io.observe(form);
    } else {
      loadTurnstile();
    }
    // Safety net: ensure the widget is present the moment the user starts filling the form.
    form.addEventListener('focusin', loadTurnstile, { once: true });
  }

  const showError = (msg: string) => {
    errorBox.textContent = msg;
    errorBox.classList.remove('hidden');
    submitBtn.disabled = false;
    submitBtn.textContent = 'Get My Free Solar Savings Analysis';
  };

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorBox.classList.add('hidden');
    submitBtn.disabled = true;
    submitBtn.textContent = 'Submitting...';

    const data = Object.fromEntries(new FormData(form));

    try {
      const res = await fetch('/api/lead', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });
      const json = await res.json() as { success: boolean; error?: string };

      if (json.success) {
        form.classList.add('hidden');
        success.classList.remove('hidden');
        const name = (data.name as string)?.split(' ')[0];
        if (name) successMsg.textContent = `Thanks, ${name}! Daniel will call you within the hour.`;
        successHeading?.focus();
      } else {
        showError(json.error || 'Something went wrong. Please call (702) 941-6894 directly.');
      }
    } catch {
      showError('Connection error. Please call (702) 941-6894 directly.');
    }
  });
</script>
