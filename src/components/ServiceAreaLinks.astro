---
interface Props {
  current?: string;
}
const { current = '' } = Astro.props;

const areas = [
  { slug: 'las-vegas', href: '/solar-las-vegas', label: 'Las Vegas, NV', sub: '$0 down · NV Energy net metering' },
  { slug: 'henderson', href: '/solar-henderson-nv', label: 'Henderson, NV', sub: 'ZIPs 89002 · 89014 · 89052 · 89074' },
  { slug: 'summerlin', href: '/solar-summerlin', label: 'Summerlin, NV', sub: 'HOA-approved installs (NRS 278.0208)' },
  { slug: 'green-valley', href: '/solar-henderson-green-valley', label: 'Green Valley, NV', sub: 'Henderson · Green Valley Ranch' },
  { slug: 'north-las-vegas', href: '/solar-north-las-vegas', label: 'North Las Vegas, NV', sub: 'Higher heat = stronger output' },
  { slug: 'california', href: '/solar-california', label: 'California', sub: 'NEM 3.0 · battery-first design' },
  { slug: 'los-angeles', href: '/solar-los-angeles', label: 'Los Angeles, CA', sub: 'LADWP · SCE service area' },
  { slug: 'san-diego', href: '/solar-san-diego', label: 'San Diego, CA', sub: 'SDG&E · fastest CA payback' },
  { slug: 'riverside', href: '/solar-riverside', label: 'Riverside, CA', sub: 'SCE · Inland Empire' },
];

const others = areas.filter(a => a.slug !== current);
---
<section class="bg-white py-12 px-4 border-t border-[#E8ECE4]">
  <div class="max-w-5xl mx-auto">
    <h2 class="font-display text-2xl font-bold text-slate-900 mb-2">Other Service Areas</h2>
    <p class="text-slate-600 text-sm mb-6">Daniel works with homeowners across Nevada and Southern California. Pick your city for local incentives, utility rules, and pricing.</p>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
      {others.map((a) => (
        <a href={a.href} class="block p-4 bg-[#FAFAF8] rounded-lg border border-[#E8ECE4] hover:border-brand-orange transition-colors">
          <div class="font-semibold text-slate-900 text-sm">{a.label}</div>
          <div class="text-slate-500 text-xs mt-1">{a.sub}</div>
        </a>
      ))}
    </div>
  </div>
</section>
