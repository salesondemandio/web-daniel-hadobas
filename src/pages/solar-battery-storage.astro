---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTAButton from '../components/CTAButton.astro';
import PersonSchema from '../components/PersonSchema.astro';
import LocalBusinessSchema from '../components/LocalBusinessSchema.astro';
import FAQSection from '../components/FAQSection.astro';

const meta = {
  title: 'Solar Battery Storage Las Vegas: Backup and Savings',
  description: 'Compare home battery storage in Las Vegas for solar self-use, outage backup, sizing, and NV Energy net metering. Get a bill-based recommendation.',
  keywords: 'solar battery storage Las Vegas, home battery backup Nevada, NV Energy peak demand, solar battery cost Las Vegas, battery installer Las Vegas, residential battery Nevada',
};

const stats = [
  { value: '24/7', label: 'Backup Power' },
  { value: '$0', label: 'Down Available' },
  { value: '10–14 kWh', label: 'Typical Single Battery' },
];

const reasons = [
  {
    title: 'Keep more of your solar for later',
    body: 'New NV Energy net-metering customers currently receive export credits at 75% of the retail rate. A battery can store part of your daytime surplus for use after the panels stop producing.',
  },
  {
    title: 'Choose the loads that need backup',
    body: 'A properly designed system can keep selected circuits running during an outage. Runtime depends on battery capacity, solar production, and the appliances you choose to back up.',
  },
  {
    title: 'Optimize an eligible time-of-use plan',
    body: 'If your NV Energy rate plan prices electricity differently by time of day, a compatible battery can be configured around those periods. Savings depend on the plan and your actual usage pattern.',
  },
  {
    title: 'Size storage from your real usage',
    body: 'Battery value changes with AC demand, pool equipment, EV charging, outage priorities, and available solar. A load-based design is more useful than a one-size package.',
  },
];

const sizingTiers = [
  {
    tier: 'Single battery',
    kwh: '~10–14 kWh',
    fits: '~1,500–2,000 sq ft, essentials backup',
    covers: 'Fridge, WiFi, lights, a few outlets, one AC zone for several hours',
  },
  {
    tier: 'Two batteries',
    kwh: '~20–28 kWh',
    fits: '~2,000–3,500 sq ft, whole-home backup',
    covers: 'Whole house including AC, EV charger pause, runs through a typical Vegas overnight outage',
  },
  {
    tier: 'Three+ batteries',
    kwh: '~30+ kWh',
    fits: '3,500+ sq ft or two-AC homes',
    covers: 'Multiple AC zones, EV charging, pool pump, days of essentials-only backup',
  },
];

const howItWorks = [
  { title: 'Solar charges the battery during the day', body: 'Excess production from your panels charges the battery instead of being exported to NV Energy at the discounted rate.' },
  { title: 'Battery powers your home during peak hours', body: 'From 4 PM onward, your house runs off stored solar — bypassing NV Energy peak rates and demand charges automatically.' },
  { title: 'Backup mode kicks in if the grid drops', body: 'When NV Energy goes down, the battery isolates from the grid in under a second and keeps the loads you backed up running until power returns or solar recharges it.' },
];

const faqs = [
  {
    question: 'How much does home battery storage cost in Las Vegas?',
    answer: 'A single residential battery installation in Las Vegas typically runs $13,000–$18,000, including the gateway, install, electrical work, and permitting. The 30% federal tax credit ended Dec 31, 2025 for systems you buy, but Nevada\'s sales-tax exemption still applies to the equipment. Adding a second battery to the same install adds roughly $9,000–$11,000 (lower per-unit cost on the second). $0 down financing is available. Daniel quotes the actual brand and configuration that fits your house — not a one-size package.',
  },
  {
    question: 'Is there still a federal tax credit for battery storage in 2026?',
    answer: 'No — not for systems you buy. The 30% federal residential tax credit (Section 25D) that covered standalone and solar-paired batteries expired December 31, 2025. Only leased or PPA (third-party-owned) systems may still capture a federal incentive, through 2027. For Nevada homeowners who buy, the value now comes from avoiding NV Energy peak and demand charges, backup power during outages, and Nevada\'s sales-tax exemption on the equipment. Talk to a tax professional about your situation.',
  },
  {
    question: 'How long will a battery run my house in a Las Vegas outage?',
    answer: "It depends on what you back up and which battery is installed. For a typical 2,000 sq ft Vegas home running essentials only (fridge, lights, WiFi, one AC zone), a single battery generally lasts several hours overnight. Two batteries covers whole-home through a typical Vegas overnight outage even with AC running. If your panels are on the next morning, the system can keep running indefinitely as long as the sun's out.",
  },
  {
    question: 'Can I get a battery without solar?',
    answer: "Yes — most modern home batteries can be installed standalone for grid backup and demand-charge management. (Note: the 30% federal tax credit for storage ended Dec 31, 2025 for systems you buy.) But the math gets dramatically better when paired with solar, because solar charges the battery for free instead of you charging it from the grid. Most Las Vegas battery installs are solar-paired for that reason.",
  },
  {
    question: 'How does battery storage work with NV Energy time-of-use rates?',
    answer: 'NV Energy peak hours (typically 4–9 PM weekdays in summer) cost dramatically more per kWh than off-peak. A properly configured battery charges from solar mid-day and discharges through the peak window, bypassing the most expensive rates. Daniel sets the system to optimize against your specific NV Energy rate plan during commissioning.',
  },
  {
    question: 'How long does battery installation take in Las Vegas?',
    answer: 'Physical install is typically one day for a single battery, two days for a pair. From signed contract to system commissioning is usually 4–6 weeks: 1–2 weeks for permitting through the city, 1–2 weeks for HOA approval if applicable, and 1–2 weeks for NV Energy interconnection and final inspection. Daniel handles all paperwork end-to-end.',
  },
  {
    question: 'What happens to the battery if I sell my house?',
    answer: 'A purchased battery transfers with the property and typically increases home value — Vegas appraisers are increasingly recognizing battery + solar as a value-add, especially in HOA neighborhoods where summer outages and high bills are common talking points. Studies show solar-plus-battery homes sell faster than comparable non-solar homes.',
  },
  {
    question: 'Which battery brand will I get?',
    answer: "It depends on which licensed installer is handling your job and what's the right fit for your house — the major residential battery brands all have strengths and tradeoffs. Daniel works with multiple top-rated installers across Nevada and California, so he can recommend the brand and configuration that actually matches your home, your roof, and your usage. He'll walk you through the options on the call.",
  },
];

const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'How a Home Battery Earns Its Keep in Las Vegas',
  description: 'How a properly configured home battery saves money on NV Energy time-of-use rates and provides backup during outages.',
  totalTime: 'PT0M',
  step: howItWorks.map((s, i) => ({
    '@type': 'HowToStep',
    position: i + 1,
    name: s.title,
    text: s.body,
  })),
};

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Solar Battery Storage Installation',
  provider: {
    '@type': 'Person',
    name: 'Daniel Hadobas',
    url: 'https://danielhadobas.com',
    telephone: '+17029416894',
  },
  areaServed: [
    { '@type': 'City', name: 'Las Vegas' },
    { '@type': 'City', name: 'Henderson' },
    { '@type': 'City', name: 'North Las Vegas' },
    { '@type': 'City', name: 'Summerlin' },
    { '@type': 'State', name: 'Nevada' },
  ],
  description: 'Home battery storage installation in Las Vegas. Demand-charge management, peak-rate avoidance, and whole-home backup for NV Energy customers.',
  offers: {
    '@type': 'Offer',
    priceCurrency: 'USD',
    eligibleRegion: { '@type': 'State', name: 'Nevada' },
    availability: 'https://schema.org/InStock',
  },
};
---

<BaseLayout title={meta.title} description={meta.description} keywords={meta.keywords}>
  <Fragment slot="schema">
    <PersonSchema />
    <LocalBusinessSchema city="Las Vegas" state="NV" description={meta.description} slug="solar-battery-storage" />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
  </Fragment>

  <!-- Hero -->
  <section class="relative overflow-hidden noise-overlay" style="background-color:#FAFAF8;background-image:radial-gradient(ellipse 80% 60% at 65% 40%, #EFF5EB 0%, #FAFAF8 70%);">
    <div class="relative max-w-6xl mx-auto px-4 sm:px-6 py-12 sm:py-20 lg:py-28">
      <!-- Mobile photo -->
      <div class="lg:hidden flex justify-center mb-8">
        <div class="w-44 h-52 sm:w-52 sm:h-64 rounded-2xl overflow-hidden border-4 border-[#6AB745] shadow-xl bg-slate-100">
          <img src="/images/daniel.jpg" alt="Daniel Hadobas — Las Vegas solar + battery specialist" class="w-full h-full object-cover object-top" width="208" height="256" loading="eager" fetchpriority="high" />
        </div>
      </div>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <div class="inline-flex items-center gap-2 bg-[#6AB745]/15 border border-[#6AB745]/35 text-[#3F6E29] rounded-full px-4 py-1.5 text-xs font-semibold mb-6">
            <span class="w-1.5 h-1.5 rounded-full bg-[#6AB745] animate-pulse"></span>
            Solar + Battery Storage · Las Vegas, NV
          </div>
          <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl text-slate-900 leading-[1.05] mb-6">
            Solar battery storage in Las Vegas
          </h1>
          <p class="text-slate-700 text-lg leading-relaxed mb-6">
            Compare storage for solar self-use and outage backup. Daniel reviews your NV Energy bills, critical loads, and current rate plan before recommending a battery size.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 mb-6">
            <CTAButton text="See If Battery Makes Sense" size="lg" />
            <a href="tel:+17029416894" class="inline-flex items-center gap-2 text-slate-900 font-semibold hover:text-[#3F6E29] transition-colors">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 8.81 19.79 19.79 0 017 2.18 2 2 0 019.09 4v3.09a2 2 0 01-1.42 1.93l-1.8.6a16 16 0 006.62 6.62l.6-1.8a2 2 0 011.92-1.42z"/></svg>
              (702) 941-6894
            </a>
          </div>
          <div class="flex flex-wrap items-center gap-4 text-xs text-slate-500">
            <span class="flex items-center gap-1.5"><svg width="14" height="14" fill="#6AB745" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg> Licensed installers</span>
            <span class="flex items-center gap-1.5"><svg width="14" height="14" fill="#6AB745" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg> Nevada tax exemption</span>
            <span class="flex items-center gap-1.5"><svg width="14" height="14" fill="#6AB745" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg> $0 down available</span>
          </div>
        </div>
        <div class="hidden lg:flex justify-center items-center">
          <div class="relative">
            <div class="w-80 h-96 rounded-2xl overflow-hidden border-4 border-[#6AB745] shadow-2xl bg-slate-100">
              <img
                src="/images/daniel.jpg"
                alt="Daniel Hadobas — Las Vegas solar + battery storage specialist"
                class="w-full h-full object-cover object-top"
                width="320" height="384"
                loading="eager"
                fetchpriority="high"
              />
            </div>
            <div class="absolute -bottom-4 -left-6 bg-white rounded-xl px-4 py-3 shadow-xl border border-slate-200">
              <p class="text-xs text-slate-500 font-medium">Vegas local</p>
              <p class="text-slate-900 font-bold text-sm">Since 1996</p>
            </div>
            <div class="absolute -top-4 -right-6 bg-[#3F6E29] text-white rounded-xl px-4 py-3 shadow-xl">
              <p class="text-xs font-semibold opacity-90">174 ★★★★★</p>
              <p class="font-bold text-xs">Google reviews</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-14 px-4 bg-white border-y border-[#E8ECE4]" aria-labelledby="battery-answer">
    <div class="max-w-4xl mx-auto">
      <p class="text-[#3F6E29] font-semibold text-sm uppercase tracking-widest mb-2">Straight answer</p>
      <h2 id="battery-answer" class="font-display text-3xl text-slate-900 mb-4">Is a home battery worth it in Las Vegas?</h2>
      <p class="text-slate-700 text-lg leading-relaxed mb-4">
        A battery can be worth considering when backup power matters, when you want to use more of your own solar after sunset, or when your rate plan rewards shifting usage. It is not automatically the best financial choice for every home. Compare the installed cost, usable capacity, warranty, supported loads, and your hourly electricity use.
      </p>
      <p class="text-slate-600 leading-relaxed">
        The <a class="font-semibold text-brand-orange hover:underline" href="https://prod.puc.nv.gov/renewables/net-metering-in-nevada/" target="_blank" rel="noopener">Public Utilities Commission of Nevada</a> confirms that new net-metering customers currently receive Tier 4 credits at 75% of the retail rate for exports. See Daniel's <a class="font-semibold text-brand-orange hover:underline" href="/blog/does-nv-energy-buy-back-solar">NV Energy buyback guide</a> for the billing details.
      </p>
    </div>
  </section>

  <!-- Stats Bar -->
  <section class="bg-[#050708] py-12 sm:py-14" aria-label="Battery storage stats">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-8">
        {stats.map((stat, i) => (
          <div class="text-center relative">
            <p class="font-display text-4xl sm:text-5xl font-bold text-[#6AB745] leading-none">{stat.value}</p>
            <p class="text-white/60 text-xs sm:text-sm mt-3 font-medium uppercase tracking-wider">{stat.label}</p>
            {i < stats.length - 1 && (
              <div class="hidden sm:block absolute right-0 top-1/2 -translate-y-1/2 w-px h-10 bg-white/10" aria-hidden="true"></div>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Why batteries in Vegas -->
  <section class="py-20 px-4 bg-[#FAFAF8]">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-12">
        <div class="section-divider mx-auto mb-4"></div>
        <h2 class="font-display text-3xl sm:text-4xl text-slate-900 mb-3">Why Las Vegas homes need a battery, not just panels.</h2>
        <p class="text-slate-600 max-w-2xl mx-auto">Solar without storage in Vegas leaves money on the table — and leaves you in the dark when the grid goes down.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {reasons.map((r) => (
          <div class="bg-white rounded-2xl p-7 border border-[#E8ECE4] shadow-[0_2px_8px_rgba(5,7,8,0.06)]">
            <div class="w-10 h-10 rounded-lg bg-[#6AB745]/15 flex items-center justify-center mb-4">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#3F6E29" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>
              </svg>
            </div>
            <h3 class="font-display text-xl text-slate-900 mb-2 leading-tight">{r.title}</h3>
            <p class="text-slate-600 text-sm leading-relaxed">{r.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="py-20 px-4 bg-[#F0F2EE] border-y border-[#DDE3D8]">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-12">
        <div class="section-divider mx-auto mb-4"></div>
        <h2 class="font-display text-3xl sm:text-4xl text-slate-900 mb-3">How a battery earns its keep.</h2>
      </div>
      <div class="relative grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="hidden md:block absolute top-[2.75rem] left-[16.67%] right-[16.67%] h-px bg-[#6AB745]/30" aria-hidden="true"></div>
        {howItWorks.map((s, i) => (
          <div class="relative bg-white rounded-2xl p-8 border border-[#E8ECE4] shadow-[0_2px_8px_rgba(5,7,8,0.06)]">
            <div class="w-11 h-11 rounded-full bg-[#6AB745] flex items-center justify-center mb-6 shadow-md shadow-[#6AB745]/30 relative z-10">
              <span class="text-white font-bold text-base">{String(i + 1).padStart(2, '0')}</span>
            </div>
            <h3 class="font-bold text-slate-900 text-lg mb-3">{s.title}</h3>
            <p class="text-slate-600 text-sm leading-relaxed">{s.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Sizing -->
  <section class="py-20 px-4 bg-[#FAFAF8]">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-12">
        <div class="section-divider mx-auto mb-4"></div>
        <h2 class="font-display text-3xl sm:text-4xl text-slate-900 mb-3">How much battery do you need?</h2>
        <p class="text-slate-600 max-w-2xl mx-auto">Daniel sizes your storage to your actual home and load profile — no overselling, no understating. Here's the rough framework.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {sizingTiers.map((t) => (
          <div class="bg-white rounded-2xl p-7 border border-[#E8ECE4] shadow-[0_4px_16px_rgba(5,7,8,0.07)]">
            <p class="text-[#6AB745] font-semibold text-sm uppercase tracking-widest mb-2">{t.tier}</p>
            <p class="font-display text-3xl text-slate-900 mb-3">{t.kwh}</p>
            <p class="text-slate-700 text-sm font-semibold mb-2">Best for: {t.fits}</p>
            <p class="text-slate-600 text-sm leading-relaxed">{t.covers}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Daniel block -->
  <section class="py-20 px-4 border-y border-[#DDE3D8]" style="background-color:#F0F2EE;background-image:radial-gradient(circle at 30% 50%, rgba(106,183,69,0.08) 0%, transparent 60%);">
    <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-10 items-center">
      <img src="/images/daniel-with-customer.jpg" alt="Daniel Hadobas reviewing a battery storage quote with a Las Vegas homeowner" class="w-full max-w-md rounded-2xl border border-[#E8ECE4] shadow-[0_8px_32px_rgba(5,7,8,0.10)] mx-auto" loading="lazy" />
      <div>
        <p class="text-[#6AB745] font-semibold text-sm uppercase tracking-widest mb-2">Why homeowners pick Daniel for battery storage</p>
        <h2 class="font-display text-3xl text-slate-900 mb-4 leading-tight">No call center. No quotas. The battery sized for your house — not theirs.</h2>
        <p class="text-slate-700 leading-relaxed mb-4">
          Most battery reps push a one-size-fits-all package and disappear after install.
          Daniel doesn't. He walks your panel, looks at your last 12 months of NV Energy bills,
          and recommends a brand and configuration that actually fits your real load profile —
          including AC, EV charging, and pool pumps if you have them.
        </p>
        <p class="text-slate-700 leading-relaxed mb-6">
          He stays on the account after install, helps you tune the system for time-of-use
          rates, and makes sure NV Energy interconnects everything cleanly so you actually
          get the savings on your bill.
        </p>
        <a href="/#get-quote" class="inline-flex items-center gap-2 bg-[#3F6E29] text-white px-7 py-3.5 rounded-lg font-bold cta-glow">
          See If Battery Makes Sense
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <FAQSection faqs={faqs} heading="Battery Storage FAQs" />

  <!-- Final CTA -->
  <section class="relative py-20 px-4 overflow-hidden" style="background-color:#6AB745;">
    <div class="relative max-w-3xl mx-auto text-center">
      <h2 class="font-display text-3xl sm:text-5xl text-white mb-4 leading-tight">Get the math on your house.</h2>
      <p class="text-white/90 mb-8 leading-relaxed max-w-xl mx-auto text-lg">
        Daniel runs your last 12 months of NV Energy bills against a battery configuration sized for your home and tells you whether it pays for itself. If it doesn't, he'll say so.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/#get-quote" class="inline-flex items-center gap-2 bg-white text-[#050708] px-8 py-4 rounded-lg font-bold text-base shadow-[0_8px_24px_rgba(5,7,8,0.20)] hover:-translate-y-0.5 hover:shadow-[0_12px_32px_rgba(5,7,8,0.28)] transition-all duration-200">
          See If Battery Makes Sense
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
        <a href="tel:+17029416894" class="text-white font-semibold hover:text-white/80 transition-colors flex items-center gap-2">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 8.81 19.79 19.79 0 017 2.18 2 2 0 019.09 4v3.09a2 2 0 01-1.42 1.93l-1.8.6a16 16 0 006.62 6.62l.6-1.8a2 2 0 011.92-1.42z"/></svg>
          Call (702) 941-6894
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
