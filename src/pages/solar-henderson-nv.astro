---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceAreaLinks from '../components/ServiceAreaLinks.astro';
import CTAButton from '../components/CTAButton.astro';
import PersonSchema from '../components/PersonSchema.astro';
import LocalBusinessSchema from '../components/LocalBusinessSchema.astro';
import StatsBar from '../components/StatsBar.astro';
import FAQSection from '../components/FAQSection.astro';
import ReviewWidget from '../components/ReviewWidget.astro';
import { hendersonContent as c } from '../data/content/cities/henderson';
import ITCNotice from '../components/ITCNotice.astro';

const planningGuides = [
  { href: '/blog/solar-henderson-zip-by-zip', label: 'Henderson solar by ZIP code' },
  { href: '/solar-henderson-green-valley', label: 'Solar in Green Valley and Green Valley Ranch' },
  { href: '/solar-battery-storage', label: 'Solar battery storage for NV Energy homes' },
  { href: '/blog/does-nv-energy-buy-back-solar', label: 'How NV Energy credits excess solar' },
];
---

<BaseLayout title={c.meta.title} description={c.meta.description} keywords={c.meta.keywords}>
  <Fragment slot="schema">
    <PersonSchema />
    <LocalBusinessSchema city="Henderson" state="NV" description={c.meta.description} />
  </Fragment>

  <section class="bg-[#FAFAF8] py-20 px-4 relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-[#F0F2EE] to-white opacity-50" aria-hidden="true"></div>
    <div class="relative max-w-4xl mx-auto">
      <div class="inline-flex items-center gap-2 bg-brand-orange/20 border border-brand-orange/30 text-brand-orange rounded-full px-4 py-1.5 text-xs font-semibold mb-6">
        ⭐ 174 Five-Star Reviews · Serving Henderson, NV
      </div>
      <h1 class="font-display text-4xl sm:text-5xl font-black text-slate-900 mb-4 leading-[1.1]">{c.hero.h1}</h1>
      <p class="text-slate-600 text-lg max-w-xl mb-8 leading-relaxed">{c.hero.subheadline}</p>
      <div class="flex flex-col sm:flex-row gap-4">
        <CTAButton text={c.cta.buttonText} size="lg" />
        <a href="tel:+17029416894" class="inline-flex items-center gap-2 text-slate-900 font-semibold hover:text-brand-orange transition-colors">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 8.81 19.79 19.79 0 017 2.18 2 2 0 019.09 4v3.09a2 2 0 01-1.42 1.93l-1.8.6a16 16 0 006.62 6.62l.6-1.8a2 2 0 011.92-1.42z"/></svg>
          (702) 941-6894
        </a>
      </div>
    </div>
  </section>

  <section class="py-12 px-4 bg-white border-y border-[#E8ECE4]" aria-labelledby="henderson-guides">
    <div class="max-w-4xl mx-auto">
      <h2 id="henderson-guides" class="text-2xl font-bold text-slate-900 mb-3">Plan a Henderson solar project</h2>
      <p class="text-slate-600 mb-6">Start with the guide closest to your neighborhood, storage needs, or NV Energy billing question.</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        {planningGuides.map((guide) => (
          <a href={guide.href} class="rounded-xl border border-[#E8ECE4] bg-[#FAFAF8] px-5 py-4 font-semibold text-slate-900 hover:border-brand-orange hover:text-brand-orange transition-colors">{guide.label}</a>
        ))}
      </div>
    </div>
  </section>

    <section class="bg-white py-12 px-4 border-y border-[#E8ECE4]">
    <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
      <img src="/images/daniel.jpg" alt="Daniel Hadobas — Las Vegas solar agent serving local homeowners" class="w-full max-w-sm rounded-2xl border border-[#E8ECE4] shadow-[0_8px_32px_rgba(5,7,8,0.08)] mx-auto" loading="lazy" width="500" height="500" />
      <div>
        <p class="text-[#6AB745] font-semibold text-sm uppercase tracking-widest mb-2">Your Local Expert</p>
        <h2 class="font-display text-3xl text-slate-900 mb-3 leading-tight">Daniel comes to you — no call center, no quotas.</h2>
        <p class="text-slate-600 leading-relaxed">Las Vegas resident since 1996. Top 1% nationally. 174 five-star reviews built entirely on referrals.</p>
      </div>
    </div>
  </section>

<section class="max-w-5xl mx-auto px-4 sm:px-6 py-12">
    <StatsBar stats={c.stats} />
  </section>

  <!-- Authority intro -->
  <section class="py-12 px-4 bg-[#FAFAF8]">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-2xl font-bold text-slate-900 mb-2">Henderson's Trusted Solar Expert</h2>
      <p class="text-brand-orange font-semibold mb-6">Daniel Hadobas · 174 Five-Star Google Reviews · Las Vegas Native Since 1996</p>
      {c.intro.map((para: string) => (
        <p class="text-slate-600 leading-relaxed mb-4 [&_a]:text-brand-orange [&_a]:underline" set:html={para} />
      ))}
    </div>
  </section>

  <section class="py-12 px-4 bg-white border-y border-[#E8ECE4]" aria-labelledby="choose-henderson">
    <div class="max-w-4xl mx-auto">
      <h2 id="choose-henderson" class="text-2xl font-bold text-slate-900 mb-4">How to Choose a Solar Company in Henderson, NV</h2>
      <p class="text-slate-600 leading-relaxed mb-4">Henderson has dozens of solar companies, and most of them sell the same panels. What separates a good deal from a bad one is who designs the system, who installs it, who services it later, and how it's financed. Before you sign with anyone, check these five things:</p>
      <ol class="list-decimal pl-6 space-y-2 text-slate-600 mb-6">
        <li><strong class="text-slate-900">A licensed Nevada contractor and NABCEP-certified installers.</strong> Ask for the contractor license number and look it up on the Nevada State Contractors Board site.</li>
        <li><strong class="text-slate-900">Written warranties.</strong> Separate panel, inverter and workmanship warranties, and who honors them if the sales company disappears.</li>
        <li><strong class="text-slate-900">A system sized to your NV Energy bill.</strong> Bring 12 months of usage. Oversized systems mean more revenue for the seller and slower payback for you.</li>
        <li><strong class="text-slate-900">Cash and financed prices side by side.</strong> "$0 down" loans often hide an 18–28% dealer fee in the price.</li>
        <li><strong class="text-slate-900">No pressure to sign the same day.</strong> A real quote is still good next week.</li>
      </ol>
      <div class="overflow-x-auto mb-6">
        <table class="w-full text-sm text-left border border-[#E8ECE4] rounded-xl">
          <thead class="bg-[#FAFAF8] text-slate-900">
            <tr><th class="p-3">Type of company</th><th class="p-3">Best for</th><th class="p-3">Watch out for</th></tr>
          </thead>
          <tbody class="text-slate-600">
            <tr class="border-t border-[#E8ECE4]"><td class="p-3"><span class="font-semibold text-slate-900">Independent solar agent</span><br />Quotes several installers and equipment brands, then manages the project for you</td><td class="p-3">Homeowners who want options and one point of contact</td><td class="p-3">Make sure the installer behind the quote is named in the contract</td></tr>
            <tr class="border-t border-[#E8ECE4]"><td class="p-3"><span class="font-semibold text-slate-900">Single local installer</span><br />Sells and installs its own crews and preferred equipment</td><td class="p-3">Simple roofs, buyers set on one brand</td><td class="p-3">You only see one price and one equipment lineup</td></tr>
            <tr class="border-t border-[#E8ECE4]"><td class="p-3"><span class="font-semibold text-slate-900">National lease / PPA provider</span><br />Owns the panels on your roof; you pay monthly or per kWh</td><td class="p-3">$0 upfront with no ownership or maintenance</td><td class="p-3">Annual escalators, highest lifetime cost, contract follows the house when you sell</td></tr>
          </tbody>
        </table>
      </div>
      <p class="text-slate-600 leading-relaxed mb-2">More detail on each choice:</p>
      <ul class="list-disc pl-6 space-y-1 text-slate-600">
        <li><a class="text-brand-orange hover:underline" href="/blog/solar-agent-vs-solar-company-difference">Solar agent vs solar company: the difference</a></li>
        <li><a class="text-brand-orange hover:underline" href="/blog/solar-lease-vs-loan-vs-cash-nevada">Solar lease vs loan vs cash in Nevada</a></li>
        <li><a class="text-brand-orange hover:underline" href="/blog/zero-down-solar-las-vegas-explained">What "$0 down" solar really means</a></li>
        <li><a class="text-brand-orange hover:underline" href="/blog/best-solar-companies-las-vegas-2026">Best solar companies in Las Vegas and Henderson (2026)</a></li>
      </ul>
    </div>
  </section>

  <section class="py-12 px-4 bg-[#FAFAF8]" aria-labelledby="henderson-cost">
    <div class="max-w-4xl mx-auto">
      <h2 id="henderson-cost" class="text-2xl font-bold text-slate-900 mb-4">Solar Panel Cost in Henderson, NV (2026)</h2>
      <p class="text-slate-600 leading-relaxed mb-4">Henderson pricing matches Las Vegas: roughly $2.60–$3.40 per watt installed, with Nevada's sales-tax exemption applied and no 30% federal credit for systems you buy in 2026.</p>
      <div class="overflow-x-auto mb-4">
        <table class="w-full text-sm text-left border border-[#E8ECE4] rounded-xl bg-white">
          <thead class="text-slate-900"><tr><th class="p-3">System size</th><th class="p-3">Typical Henderson home</th><th class="p-3">Cash price range</th></tr></thead>
          <tbody class="text-slate-600">
            <tr class="border-t border-[#E8ECE4]"><td class="p-3">6 kW</td><td class="p-3">Townhome or ~1,500 sq ft</td><td class="p-3">~$15,600–$20,400</td></tr>
            <tr class="border-t border-[#E8ECE4]"><td class="p-3">8 kW</td><td class="p-3">~1,800–2,200 sq ft (most common)</td><td class="p-3">~$20,800–$27,200</td></tr>
            <tr class="border-t border-[#E8ECE4]"><td class="p-3">10 kW</td><td class="p-3">~2,400 sq ft+, pool or EV</td><td class="p-3">~$26,000–$34,000</td></tr>
          </tbody>
        </table>
      </div>
      <p class="text-slate-600 text-sm leading-relaxed mb-4"><strong class="text-slate-900">What moves your price:</strong> roof type, pitch and shading, panel and inverter brand, main-panel upgrades, battery add-ons, HOA and permit requirements, and cash vs financing. These ranges are a starting point; your quote depends on your home.</p>
      <p class="text-slate-600 leading-relaxed">A battery adds about $11,000–$15,000. See the full <a class="text-brand-orange hover:underline" href="/blog/solar-cost-las-vegas-2026">Las Vegas and Henderson solar cost breakdown</a> and the <a class="text-brand-orange hover:underline" href="/blog/solar-payback-period-las-vegas">payback period math</a>.</p>
    </div>
  </section>

  <section class="py-12 px-4 bg-[#FAFAF8]">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-2xl font-bold text-slate-900 mb-8">Nevada Solar Incentives for Henderson Homeowners</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        {c.incentives.map((inc: any) => (
          <div class="bg-[#FAFAF8] rounded-xl p-6 border border-slate-200 shadow-sm">
            <h3 class="font-semibold text-slate-900 mb-2">{inc.title}</h3>
            <p class="text-slate-600 text-sm leading-relaxed [&_a]:text-brand-orange [&_a]:underline" set:html={inc.description} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-10 px-4 bg-[#FAFAF8]">
    <div class="max-w-4xl mx-auto"><ReviewWidget /></div>
  </section>

  <section class="px-4"><div class="max-w-3xl mx-auto"><ITCNotice /></div></section>
  <FAQSection faqs={c.faqs} heading="Solar FAQs — Henderson, NV" />

  <section class="bg-[#FAFAF8] py-16 px-4 text-center">
    <div class="max-w-2xl mx-auto">
      <h2 class="font-display text-3xl font-bold text-slate-900 mb-4">{c.cta.headline}</h2>
      <p class="text-slate-600 mb-8">{c.cta.subheadline}</p>
      <CTAButton text={c.cta.buttonText} size="lg" />
    </div>
  </section>
  <ServiceAreaLinks current="henderson" />

