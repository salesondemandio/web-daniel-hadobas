---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTAButton from '../components/CTAButton.astro';
import PersonSchema from '../components/PersonSchema.astro';
import LocalBusinessSchema from '../components/LocalBusinessSchema.astro';
import StatsBar from '../components/StatsBar.astro';
import FAQSection from '../components/FAQSection.astro';
import ReviewWidget from '../components/ReviewWidget.astro';
import ServiceAreaLinks from '../components/ServiceAreaLinks.astro';
import { lasVegasContent as c } from '../data/content/cities/las-vegas';
import ITCNotice from '../components/ITCNotice.astro';

const planningGuides = [
  { href: '/blog/solar-cost-las-vegas-2026', label: '2026 solar cost and payback' },
  { href: '/blog/best-solar-companies-las-vegas-2026', label: 'How to compare Las Vegas solar companies' },
  { href: '/solar-battery-storage', label: 'Solar battery storage in Las Vegas' },
  { href: '/blog/does-nv-energy-buy-back-solar', label: 'NV Energy net-metering credits' },
  { href: '/solar-agent-vs-solar-company', label: 'Solar agent vs solar company' },
  { href: '/beat-the-rate-hike', label: 'Beat NV Energy rate hikes with solar' },
];
---

<BaseLayout title={c.meta.title} description={c.meta.description} keywords={c.meta.keywords}>
  <Fragment slot="schema">
    <PersonSchema />
    <LocalBusinessSchema city="Las Vegas" state="NV" description={c.meta.description} />
  </Fragment>

  <section class="bg-[#FAFAF8] py-20 px-4 relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-[#F0F2EE] to-white opacity-50" aria-hidden="true"></div>
    <div class="relative max-w-4xl mx-auto">
      <div class="inline-flex items-center gap-2 bg-brand-orange/20 border border-brand-orange/30 text-brand-orange rounded-full px-4 py-1.5 text-xs font-semibold mb-6">
        Serving Las Vegas, NV &amp; Surrounding Areas
      </div>
      <h1 class="font-display text-4xl sm:text-5xl font-black text-slate-900 mb-4 leading-[1.1]">
        {c.hero.h1}
      </h1>
      <p class="text-slate-600 text-lg max-w-xl mb-8 leading-relaxed">{c.hero.subheadline}</p>
      <div class="flex flex-col sm:flex-row gap-4">
        <CTAButton text={c.cta.buttonText} size="lg" />
        <a href="tel:+17029416894" class="inline-flex items-center gap-2 text-slate-900 font-semibold hover:text-brand-orange transition-colors">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 8.81 19.79 19.79 0 017 2.18 2 2 0 019.09 4v3.09a2 2 0 01-1.42 1.93l-1.8.6a16 16 0 006.62 6.62l.6-1.8a2 2 0 011.92-1.42z"/></svg>
          (702) 941-6894
        </a>
      </div>
    </div>
  </section>

  <section class="py-12 px-4 bg-white border-y border-[#E8ECE4]" aria-labelledby="las-vegas-guides">
    <div class="max-w-4xl mx-auto">
      <h2 id="las-vegas-guides" class="text-2xl font-bold text-slate-900 mb-3">Plan a Las Vegas solar project</h2>
      <p class="text-slate-600 mb-6">Use these local guides to compare cost, providers, storage, and NV Energy billing before requesting a proposal.</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        {planningGuides.map((guide) => (
          <a href={guide.href} class="rounded-xl border border-[#E8ECE4] bg-[#FAFAF8] px-5 py-4 font-semibold text-slate-900 hover:border-brand-orange hover:text-brand-orange transition-colors">{guide.label}</a>
        ))}
      </div>
    </div>
  </section>

    <section class="bg-white py-12 px-4 border-y border-[#E8ECE4]">
    <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
      <img src="/images/daniel.jpg" alt="Daniel Hadobas — Las Vegas solar agent serving local homeowners" class="w-full max-w-sm rounded-2xl border border-[#E8ECE4] shadow-[0_8px_32px_rgba(5,7,8,0.08)] mx-auto" loading="lazy" width="500" height="500" />
      <div>
        <p class="text-[#6AB745] font-semibold text-sm uppercase tracking-widest mb-2">Your Local Expert</p>
        <h2 class="font-display text-3xl text-slate-900 mb-3 leading-tight">Daniel comes to you — no call center, no quotas.</h2>
        <p class="text-slate-600 leading-relaxed">Las Vegas resident since 1996. Top 1% nationally. 174 five-star reviews built entirely on referrals.</p>
      </div>
    </div>
  </section>

<section class="max-w-5xl mx-auto px-4 sm:px-6 py-12">
    <StatsBar stats={c.stats} />
  </section>

  <section class="py-12 px-4 bg-[#FAFAF8]">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-2xl font-bold text-slate-900 mb-6">Why Go Solar in Las Vegas?</h2>
      {c.intro.map((para) => (
        <p class="text-slate-600 leading-relaxed mb-4 [&_a]:text-brand-orange [&_a]:underline" set:html={para} />
      ))}
    </div>
  </section>

  <section class="py-12 px-4 bg-white border-y border-[#E8ECE4]" aria-labelledby="lv-cost">
    <div class="max-w-4xl mx-auto">
      <h2 id="lv-cost" class="text-2xl font-bold text-slate-900 mb-4">How Much Do Solar Panels Cost in Las Vegas?</h2>
      <p class="text-slate-600 leading-relaxed mb-4">In 2026, installed solar in Las Vegas runs about $2.60–$3.40 per watt with Nevada's sales-tax exemption applied. The 30% federal credit ended December 31, 2025 for systems you buy, so these are real cash prices.</p>
      <div class="overflow-x-auto mb-4">
        <table class="w-full text-sm text-left border border-[#E8ECE4] rounded-xl">
          <thead class="bg-[#FAFAF8] text-slate-900"><tr><th class="p-3">System size</th><th class="p-3">Monthly NV Energy bill it offsets</th><th class="p-3">Cash price range</th></tr></thead>
          <tbody class="text-slate-600">
            <tr class="border-t border-[#E8ECE4]"><td class="p-3">5 kW</td><td class="p-3">~$100–$140</td><td class="p-3">~$13,000–$17,000</td></tr>
            <tr class="border-t border-[#E8ECE4]"><td class="p-3">7 kW</td><td class="p-3">~$160–$200</td><td class="p-3">~$18,200–$23,800</td></tr>
            <tr class="border-t border-[#E8ECE4]"><td class="p-3">9 kW</td><td class="p-3">~$210–$260</td><td class="p-3">~$23,400–$30,600</td></tr>
            <tr class="border-t border-[#E8ECE4]"><td class="p-3">12 kW</td><td class="p-3">$280+ (pool, EV, large home)</td><td class="p-3">~$31,200–$40,800</td></tr>
          </tbody>
        </table>
      </div>
      <p class="text-slate-600 leading-relaxed">Full breakdown: <a class="text-brand-orange hover:underline" href="/blog/solar-cost-las-vegas-2026">Las Vegas solar cost in 2026</a> · <a class="text-brand-orange hover:underline" href="/blog/solar-payback-period-las-vegas">payback period</a> · <a class="text-brand-orange hover:underline" href="/blog/tesla-powerwall-las-vegas">adding a Powerwall</a>.</p>
    </div>
  </section>

  <section class="py-12 px-4 bg-[#FAFAF8]" aria-labelledby="lv-process">
    <div class="max-w-4xl mx-auto">
      <h2 id="lv-process" class="text-2xl font-bold text-slate-900 mb-4">Buying Solar Panels in Las Vegas: How It Works</h2>
      <ol class="list-decimal pl-6 space-y-2 text-slate-600">
        <li><strong class="text-slate-900">Bill review.</strong> Daniel looks at 12 months of your NV Energy usage to size the system to what you actually use.</li>
        <li><strong class="text-slate-900">Side-by-side quotes.</strong> Cash, loan and lease options from vetted, NABCEP-certified installers, with the dealer fee visible.</li>
        <li><strong class="text-slate-900">Design, permits and HOA.</strong> Nevada law (NRS 278.0208) limits how far an HOA can block rooftop solar.</li>
        <li><strong class="text-slate-900">Install and NV Energy interconnection.</strong> Once NV Energy approves the system, net metering credits your exports at 75% of the retail rate, locked for 20 years.</li>
      </ol>
      <p class="text-slate-600 leading-relaxed mt-4">Not sure who to hire? Read <a class="text-brand-orange hover:underline" href="/solar-agent-vs-solar-company">solar agent vs solar company</a> and <a class="text-brand-orange hover:underline" href="/blog/solar-lease-vs-loan-vs-ppa-pros-cons">lease vs PPA vs buying</a>.</p>
    </div>
  </section>

  <section class="py-12 px-4 bg-[#FAFAF8]">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-2xl font-bold text-slate-900 mb-8">Nevada Solar Incentives</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        {c.incentives.map((inc) => (
          <div class="bg-[#FAFAF8] rounded-xl p-6 border border-slate-200 shadow-sm">
            <div class="w-8 h-8 rounded-lg bg-brand-orange/10 flex items-center justify-center mb-3">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#F97316" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            </div>
            <h3 class="font-semibold text-slate-900 mb-2">{inc.title}</h3>
            <p class="text-slate-600 text-sm leading-relaxed [&_a]:text-brand-orange [&_a]:underline" set:html={inc.description} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-10 px-4 bg-[#FAFAF8]">
    <div class="max-w-4xl mx-auto">
      <ReviewWidget />
    </div>
  </section>

  <section class="px-4"><div class="max-w-3xl mx-auto"><ITCNotice /></div></section>
  <FAQSection faqs={c.faqs} heading="Solar FAQs — Las Vegas, NV" />

  <ServiceAreaLinks current="las-vegas" />

  <section class="bg-[#FAFAF8] py-16 px-4 text-center">
    <div class="max-w-2xl mx-auto">
      <h2 class="font-display text-3xl font-bold text-slate-900 mb-4">{c.cta.headline}</h2>
      <p class="text-slate-600 mb-8">{c.cta.subheadline}</p>
      <CTAButton text={c.cta.buttonText} size="lg" />
    </div>
  </section>
</BaseLayout>
