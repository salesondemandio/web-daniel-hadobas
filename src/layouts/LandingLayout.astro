---
// Distraction-free landing layout for paid/email campaign pages.
// Keeps GA, AudienceLab pixel, fonts, SEO/OG, and the schema slot — but strips
// the site nav and footer link-maze down to logo + click-to-call so the only
// path forward is the form. Dark "energy command center" canvas.
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
}

const { title, description, canonical = Astro.url.href } = Astro.props;

const ORIGIN = 'https://danielhadobas.com';
let _path = (canonical.startsWith('http') ? new URL(canonical).pathname : canonical) || '/';
_path = _path.replace(/index\.html$/i, '').replace(/\.html$/i, '');
if (_path.length > 1) _path = _path.replace(/\/+$/, '');
if (!_path.startsWith('/')) _path = '/' + _path;
const canonicalClean = _path === '/' ? ORIGIN + '/' : ORIGIN + _path;

const phone = '+17029416894';
const phoneDisplay = '(702) 941-6894';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalClean} />
  <meta name="robots" content="index, follow" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preload" as="image" href="/images/daniel.jpg" />

  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalClean} />
  <meta property="og:site_name" content="Daniel Hadobas Solar" />
  <meta property="og:image" content="https://danielhadobas.com/og-v2.jpg" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content="https://danielhadobas.com/og-v2.jpg" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=DM+Serif+Display:ital@0;1&display=swap" onload="this.onload=null;this.rel='stylesheet'" />
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=DM+Serif+Display:ital@0;1&display=swap" /></noscript>

  <slot name="schema" />

  <!-- Google Analytics -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-QTLWYZSFY0"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-QTLWYZSFY0');
  </script>

  <!-- AudienceLab identity pixel -->
  <script src="https://cdn.idpixel.app/v1/idp-analytics-6a0b9cc2fab915af2e99d321.min.js" data-ga4-key="G-QTLWYZSFY0" defer></script>

  <!-- Meta Pixel Code -->
  <script>
    !function(f,b,e,v,n,t,s)
    {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
    n.callMethod.apply(n,arguments):n.queue.push(arguments)};
    if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
    n.queue=[];t=b.createElement(e);t.async=!0;
    t.src=v;s=b.getElementsByTagName(e)[0];
    s.parentNode.insertBefore(t,s)}(window, document,'script',
    'https://connect.facebook.net/en_US/fbevents.js');
    fbq('init', '909117527285975');
    fbq('track', 'PageView');
  </script>
  <noscript><img height="1" width="1" style="display:none"
    src="https://www.facebook.com/tr?id=909117527285975&ev=PageView&noscript=1"
  /></noscript>
  <!-- End Meta Pixel Code -->

  <style is:global>
    .lp-canvas {
      background-color: #07140D;
      color: #fff;
    }
    /* luminous green elevation instead of flat drop shadows */
    .lp-glow { box-shadow: 0 0 0 1px rgba(141,214,106,0.12), 0 24px 70px -30px rgba(106,183,69,0.45); }
    .lp-hairline { border-color: rgba(255,255,255,0.08); }
    .lp-muted { color: #AEC8B5; }
    .lp-faint { color: #8FAE9D; }
    /* animated chart bars grow on load */
    @keyframes lp-bar-grow { from { transform: scaleY(0); } to { transform: scaleY(1); } }
    .lp-bar { transform-origin: bottom; animation: lp-bar-grow 0.9s cubic-bezier(0.22,1,0.36,1) forwards; }
    @keyframes lp-line-draw { from { stroke-dashoffset: 320; } to { stroke-dashoffset: 0; } }
    .lp-line { stroke-dasharray: 320; animation: lp-line-draw 1.4s ease-out 0.5s forwards; stroke-dashoffset: 320; }
    @media (prefers-reduced-motion: reduce) {
      .lp-bar, .lp-line, .fade-up { animation: none !important; opacity: 1 !important; transform: none !important; stroke-dashoffset: 0 !important; }
    }
  </style>
</head>
<body class="lp-canvas min-h-screen flex flex-col antialiased">

  <!-- Minimal header: logo + click-to-call only. No exit links. -->
  <header class="relative z-30">
    <div class="max-w-6xl mx-auto px-5 sm:px-8 h-18 py-4 flex items-center justify-between">
      <a href="#get-quote" class="flex items-center gap-2.5" aria-label="Daniel Hadobas Solar — get a free quote">
        <span class="w-9 h-9 rounded-full bg-gradient-to-br from-[#6AB745] to-[#4F8A33] flex items-center justify-center">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <circle cx="12" cy="12" r="4" fill="#07140D"/>
            <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" stroke="#07140D" stroke-width="2.2" stroke-linecap="round"/>
          </svg>
        </span>
        <span class="font-semibold text-white text-base leading-none">
          Daniel Hadobas <span class="text-[#8DD66A]">Solar</span>
        </span>
      </a>

      <a href={`tel:${phone}`}
         class="inline-flex items-center gap-2 text-sm font-semibold text-white hover:text-[#8DD66A] transition-colors">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 8.81 19.79 19.79 0 0117 2.18 2 2 0 0119.08 4v3.09a2 2 0 01-1.42 1.93l-1.8.6a16 16 0 006.62 6.62l.6-1.8a2 2 0 011.92-1.42z"/></svg>
        <span class="hidden sm:inline">{phoneDisplay}</span>
        <span class="sm:hidden">Call</span>
      </a>
    </div>
  </header>

  <main class="flex-1">
    <slot />
  </main>

  <!-- Minimal footer: legal + call only -->
  <footer class="relative z-10 border-t lp-hairline">
    <div class="max-w-6xl mx-auto px-5 sm:px-8 py-8 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs lp-faint">
      <p>Daniel Hadobas · Licensed Solar Energy Specialist · Las Vegas, NV &amp; California</p>
      <div class="flex items-center gap-4">
        <a href={`tel:${phone}`} class="hover:text-[#8DD66A] transition-colors">{phoneDisplay}</a>
        <span>&copy; {new Date().getFullYear()}</span>
      </div>
    </div>
  </footer>

  <script>
    // Lead & call tracking (mirrors BaseLayout)
    const pagePath = window.location.pathname;
    document.addEventListener('click', (e) => {
      const link = (e.target as Element).closest('a');
      if (!link) return;
      if (link.href.startsWith('tel:')) {
        // @ts-ignore
        if (typeof gtag !== 'undefined') gtag('event', 'phone_call_click', { phone_number: '+17029416894', page_path: pagePath });
      }
    });
  </script>
</body>
</html>
